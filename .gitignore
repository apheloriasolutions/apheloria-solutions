# Material fuente interno: lleva referencias de proveedor, no debe publicarse
# (el patrón con * evita problemas con la Ó en macOS)
C*DIGOS GENERALES.xlsx

# Archivos temporales de Office (se crean al tener un Excel abierto)
~$*

# Fichas técnicas originales en Excel: material de trabajo, no se publica
fuentes/

# Los PDF generados desde las fichas: se suben aparte al hosting, no a git
fichas/

# El catálogo en PDF se genera con scripts/catalogo/construir_catalogo.py
docs/catalogo/catalogo-apheloria.pdf
docs/catalogo/catalogo-apheloria-correo.pdf

# Material de revisión interno: no se publica
_revision/

# El catálogo completo también se genera (scripts/catalogo/construir_catalogo_completo.py)
docs/catalogo/catalogo-completo.pdf
docs/catalogo/catalogo-completo-correo.pdf
